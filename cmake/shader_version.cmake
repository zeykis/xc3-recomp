# Writes OUT = shader_version.h: an id of the shader translator's source (Eden's recompiler, sirit, our glue), so the
# translated-shader cache (shader_cache.bin) is kept across rebuilds and compilers and only starts over when the
# translator itself changes. It used to be the compile date and time: every rebuild threw the cache away.
#   cmake -DROOT=<source dir> -DOUT=<header> -P cmake/shader_version.cmake
file(GLOB_RECURSE files
  ${ROOT}/third_party/shader_recompiler/*.cpp ${ROOT}/third_party/shader_recompiler/*.h
  ${ROOT}/third_party/sirit/src/*.cpp ${ROOT}/third_party/sirit/src/*.h ${ROOT}/third_party/sirit/include/*.h
  ${ROOT}/runtime/src/gpu_shader.cpp ${ROOT}/runtime/src/gpu_shader.h)
list(SORT files)
set(acc "")
foreach(f IN LISTS files)
  file(SHA256 "${f}" h)
  file(RELATIVE_PATH rel "${ROOT}" "${f}")
  string(APPEND acc "${rel}:${h};")
endforeach()
string(SHA256 v "${acc}")
string(SUBSTRING "${v}" 0 16 v)
set(content "/* generated by cmake/shader_version.cmake */\n#define XC3_SHADER_TRANSLATOR_ID \"${v}\"\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
